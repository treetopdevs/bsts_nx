```elixir
defmodule NotebookHelpers do
  alias VegaLite, as: Vl

  def seed!(seed \\ 42) do
    :rand.seed(:exsss, {seed, seed + 1, seed + 2})
    Nx.Random.key(seed)
  end

  defp loud_warning(lines, label \\ "BACKEND") do
    banner = String.duplicate("!", 92)
    IO.puts("")
    IO.puts(banner)
    IO.puts("!!! #{label} WARNING: REQUESTED BACKEND IS NOT ACTIVE !!!")
    Enum.each(lines, &IO.puts/1)
    IO.puts(banner)
    IO.puts("")
  end

  def backend_status do
    process_count = :erlang.system_info(:process_count)
    process_limit = :erlang.system_info(:process_limit)

    %{
      default_backend: Nx.default_backend(),
      process_count: process_count,
      process_limit: process_limit,
      headroom: process_limit - process_count
    }
  end

  def use_binary! do
    Nx.global_default_backend(Nx.BinaryBackend)
    backend_status()
  end

  def try_emlx!(opts \\ []) do
    warn = Keyword.get(opts, :warn, true)

    result =
      if Code.ensure_loaded?(EMLX.Backend) do
        try do
          Nx.global_default_backend(EMLX.Backend)
          Nx.Defn.global_default_options(compiler: Nx.Defn.Evaluator)
          _ = Nx.backend_transfer(Nx.tensor([0.0]), EMLX.Backend)

          backend_status()
          |> Map.put(:emlx_status, :enabled)
        rescue
          error ->
            Nx.global_default_backend(Nx.BinaryBackend)
            Nx.Defn.global_default_options(compiler: Nx.Defn.Evaluator)

            backend_status()
            |> Map.put(:emlx_status, :fallback_binary)
            |> Map.put(:emlx_error, Exception.message(error))
        catch
          :exit, reason ->
            Nx.global_default_backend(Nx.BinaryBackend)
            Nx.Defn.global_default_options(compiler: Nx.Defn.Evaluator)

            backend_status()
            |> Map.put(:emlx_status, :fallback_binary)
            |> Map.put(:emlx_error, inspect(reason))
        end
      else
        backend_status()
        |> Map.put(:emlx_status, :unavailable)
      end

    if warn and result.emlx_status != :enabled do
      base_lines = [
        "Current Nx backend: #{inspect(result.default_backend)}",
        "EMLX status: #{inspect(result.emlx_status)}",
        "Structured sections (7.2/9.2) may be slower without a supported compiled backend."
      ]

      lines =
        case result.emlx_status do
          :fallback_binary ->
            [
              "EMLX activation failed and backend fell back to BinaryBackend.",
              "EMLX error: #{Map.get(result, :emlx_error)}"
              | base_lines
            ]

          :unavailable ->
            ["EMLX is unavailable in this environment." | base_lines]

          other ->
            ["EMLX unavailable (status #{inspect(other)})." | base_lines]
        end

      loud_warning(lines, "EMLX")
    end

    result
  end

  def try_exla!(opts \\ []) do
    min_headroom = Keyword.get(opts, :min_headroom, 10_000)
    warn = Keyword.get(opts, :warn, true)
    status = backend_status()

    result =
      if status.headroom < min_headroom do
        Nx.global_default_backend(Nx.BinaryBackend)

        backend_status()
        |> Map.put(:exla_status, :skipped_low_headroom)
        |> Map.put(:min_headroom, min_headroom)
      else
        try do
          # Keep BinaryBackend for eager ops (loops in Smoother.rts, etc.)
          # and use EXLA only as the defn compiler. This avoids spawning
          # an EXLA CallbackServer for every small Nx operation in tight loops.
          Nx.global_default_backend(Nx.BinaryBackend)
          Nx.Defn.global_default_options(compiler: EXLA)
          _ = Nx.backend_transfer(Nx.tensor([0.0]), EXLA.Backend)

          backend_status()
          |> Map.put(:exla_status, :enabled)
          |> Map.put(:exla_mode, :compiler_only)
        rescue
          error ->
            Nx.global_default_backend(Nx.BinaryBackend)
            Nx.Defn.global_default_options(compiler: Nx.Defn.Evaluator)

            backend_status()
            |> Map.put(:exla_status, :fallback_binary)
            |> Map.put(:exla_error, Exception.message(error))
        catch
          :exit, reason ->
            Nx.global_default_backend(Nx.BinaryBackend)
            Nx.Defn.global_default_options(compiler: Nx.Defn.Evaluator)

            backend_status()
            |> Map.put(:exla_status, :fallback_binary)
            |> Map.put(:exla_error, inspect(reason))
        end
      end

    if warn and result.exla_status != :enabled do
      base_lines = [
        "Current Nx backend: #{inspect(result.default_backend)}",
        "Process usage: #{result.process_count}/#{result.process_limit} (headroom #{result.headroom})",
        "Structured sections (7.2/9.2) may be much slower without EXLA or another supported compiled backend."
      ]

      lines =
        case result.exla_status do
          :skipped_low_headroom ->
            [
              "EXLA activation skipped: low process headroom (< #{result.min_headroom})."
              | base_lines
            ]

          :fallback_binary ->
            [
              "EXLA activation failed and backend fell back to BinaryBackend.",
              "EXLA error: #{Map.get(result, :exla_error)}"
              | base_lines
            ]

          other ->
            ["EXLA unavailable (status #{inspect(other)})." | base_lines]
        end

      loud_warning(lines, "EXLA")
    end

    result
  end

  def try_compiled_backend!(opts \\ []) do
    warn = Keyword.get(opts, :warn, true)
    emlx_result = try_emlx!(Keyword.put(opts, :warn, false))

    if emlx_result.emlx_status == :enabled do
      emlx_result
      |> Map.put(:compiled_backend, :emlx)
    else
      exla_result = try_exla!(Keyword.put(opts, :warn, false))

      compiled_backend =
        if exla_result.exla_status == :enabled do
          :exla
        else
          :binary
        end

      result =
        exla_result
        |> Map.put(:compiled_backend, compiled_backend)
        |> Map.put(:emlx_status, emlx_result.emlx_status)
        |> Map.put(:emlx_error, Map.get(emlx_result, :emlx_error))

      if warn and compiled_backend == :binary do
        lines = [
          "Current Nx backend: #{inspect(result.default_backend)}",
          "EMLX status: #{inspect(result.emlx_status)}",
          "EXLA status: #{inspect(result.exla_status)}",
          "Structured sections (7.2/9.2) will be slower on BinaryBackend."
        ]

        loud_warning(lines, "COMPILED BACKEND")
      end

      result
    end
  end

  def assert_gibbs_sampler_runtime!(project_root) do
    source = to_string(BstsNx.GibbsSampler.module_info(:compile)[:source] || "")

    source_ok? =
      String.starts_with?(source, project_root) and
        String.ends_with?(source, "/lib/bsts_nx/gibbs_sampler.ex")

    beam = :code.which(BstsNx.GibbsSampler)

    has_nan_clause? =
      case :beam_lib.chunks(beam, [:abstract_code]) do
        {:ok, {_, [{:abstract_code, {:raw_abstract_v1, forms}}]}} ->
          case Enum.find(forms, fn
                 {:function, _, :safe_to_number, 1, _} -> true
                 _ -> false
               end) do
            {:function, _, :safe_to_number, 1, clauses} ->
              Enum.any?(clauses, fn
                {:clause, _, [{:atom, _, :nan}], _, _} -> true
                _ -> false
              end)

            _ ->
              false
          end

        _ ->
          false
      end

    unless source_ok? and has_nan_clause? do
      raise """
      Livebook loaded stale BstsNx bytecode (missing safe_to_number(:nan) protection).
      Source seen: #{source}
      Expected project root: #{project_root}

      Fix:
      1) Runtime -> Disconnect and Reconnect
      2) Reopen this notebook from disk:
         #{Path.join([project_root, "livebooks", "bsts_nx_statistical_journey.livemd"])}
      3) Run setup cell again and confirm:
         Notebook revision: 2026-05-20 (Nx 0.12 backend fallback guidance)
      """
    end

    :ok
  end

  def mean(list) when is_list(list) and list != [] do
    Enum.sum(list) / length(list)
  end

  def mean(_), do: 0.0

  def sd(list) when is_list(list) and length(list) > 1 do
    m = mean(list)
    ss = Enum.reduce(list, 0.0, fn x, acc -> acc + (x - m) * (x - m) end)
    :math.sqrt(ss / (length(list) - 1))
  end

  def sd(_), do: 0.0

  def mae(a, b) when is_list(a) and is_list(b) and a != [] and length(a) == length(b) do
    Enum.zip(a, b)
    |> Enum.map(fn {x, y} -> abs(x - y) end)
    |> mean()
  end

  def mae(_, _), do: 0.0

  def rmse(a, b) when is_list(a) and is_list(b) and a != [] and length(a) == length(b) do
    Enum.zip(a, b)
    |> Enum.map(fn {x, y} -> (x - y) * (x - y) end)
    |> mean()
    |> :math.sqrt()
  end

  def rmse(_, _), do: 0.0

  def quantile(sorted, q) when sorted != [] do
    pos = q * (length(sorted) - 1)
    lo = trunc(:math.floor(pos))
    hi = trunc(:math.ceil(pos))

    if lo == hi do
      Enum.at(sorted, lo)
    else
      w = pos - lo
      (1.0 - w) * Enum.at(sorted, lo) + w * Enum.at(sorted, hi)
    end
  end

  def quantile(_, _), do: :nan

  def posterior_mean(draws) when is_list(draws) and draws != [] do
    n = length(draws)
    Enum.zip_with(draws, fn vals -> Enum.sum(vals) / n end)
  end

  def posterior_mean(_), do: []

  def posterior_var(draws) when is_list(draws) and draws != [] do
    draws
    |> Enum.zip_with(fn vals ->
      m = Enum.sum(vals) / length(vals)
      ss = Enum.reduce(vals, 0.0, fn x, acc -> acc + (x - m) * (x - m) end)
      ss / max(length(vals) - 1, 1)
    end)
  end

  def posterior_var(_), do: []

  def per_t_bands(draws, alpha \\ 0.05)

  def per_t_bands(draws, alpha) when is_list(draws) and draws != [] do
    Enum.zip_with(draws, fn vals ->
      sorted = Enum.sort(vals)

      %{
        mean: Enum.sum(vals) / length(vals),
        lower: quantile(sorted, alpha / 2.0),
        upper: quantile(sorted, 1.0 - alpha / 2.0)
      }
    end)
  end

  def per_t_bands(_, _), do: []

  def downsample(series, every) do
    series
    |> Enum.chunk_every(every, every, :discard)
    |> Enum.map(fn chunk -> Enum.sum(chunk) / length(chunk) end)
  end

  def to_rows(series_map) when is_map(series_map) do
    series_map
    |> Enum.flat_map(fn {name, values} ->
      Enum.with_index(values)
      |> Enum.map(fn {v, t} ->
        %{series: name, t: t, value: v}
      end)
    end)
  end

  def line_plot(rows, opts \\ []) do
    width = Keyword.get(opts, :width, 900)
    height = Keyword.get(opts, :height, 320)
    title = Keyword.get(opts, :title)
    legend_title = Keyword.get(opts, :legend_title, "series")

    Vl.new(width: width, height: height, title: title)
    |> Vl.data_from_values(rows)
    |> Vl.mark(:line)
    |> Vl.encode_field(:x, "t", type: :quantitative, title: "time index")
    |> Vl.encode_field(:y, "value", type: :quantitative)
    |> Vl.encode_field(:color, "series",
      type: :nominal,
      legend: [title: legend_title, orient: :bottom]
    )
    |> Kino.VegaLite.new()
  end

  def interval_plot(rows, opts \\ []) do
    width = Keyword.get(opts, :width, 900)
    height = Keyword.get(opts, :height, 320)
    title = Keyword.get(opts, :title)
    legend_title = Keyword.get(opts, :legend_title, "series")

    plot_rows =
      Enum.flat_map(rows, fn row ->
        [
          %{series: "actual", t: row.t, value: row.actual},
          %{series: "counterfactual mean", t: row.t, value: row.mean},
          %{series: "lower band", t: row.t, value: row.lower},
          %{series: "upper band", t: row.t, value: row.upper}
        ]
      end)

    Vl.new(width: width, height: height, title: title)
    |> Vl.data_from_values(plot_rows)
    |> Vl.mark(:line)
    |> Vl.encode_field(:x, "t", type: :quantitative, title: "time index")
    |> Vl.encode_field(:y, "value", type: :quantitative)
    |> Vl.encode_field(:color, "series",
      type: :nominal,
      legend: [title: legend_title, orient: :bottom]
    )
    |> Kino.VegaLite.new()
  end

  def bar_plot(rows, opts \\ []) do
    width = Keyword.get(opts, :width, 900)
    height = Keyword.get(opts, :height, 320)
    title = Keyword.get(opts, :title)
    legend_title = Keyword.get(opts, :legend_title, "category")

    Vl.new(width: width, height: height, title: title)
    |> Vl.data_from_values(rows)
    |> Vl.mark(:bar)
    |> Vl.encode_field(:x, "label", type: :nominal, title: "category")
    |> Vl.encode_field(:y, "value", type: :quantitative)
    |> Vl.encode_field(:color, "label",
      type: :nominal,
      legend: [title: legend_title, orient: :bottom]
    )
    |> Kino.VegaLite.new()
  end
end

NotebookHelpers.seed!(2026)
backend_setup = NotebookHelpers.try_compiled_backend!(min_headroom: 10_000, warn: true)
NotebookHelpers.assert_gibbs_sampler_runtime!(project_root)
IO.puts("Compiled backend selected: #{inspect(backend_setup.compiled_backend)}")
IO.puts("Active Nx backend after setup: #{inspect(Nx.default_backend())}")
backend_setup
